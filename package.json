{
  "name": "uday-magazine-portal",
  "version": "1.0.0",
  "type": "module",
  "description": "Official Website of UDAY Magazine - IISER Bhopal",
  "main": "server/server.js",
  "scripts": {
    "server": "node server/server.js",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "dev": "concurrently \"node server/server.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
